# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_kit
# Optional isolated targets for tests and the destructive demo reset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_kit_test
DEMO_DATABASE_URL=
# Required to run the demo reset with NODE_ENV=production or a non-loopback host.
ALLOW_DEMO_SEED=0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter_kit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth sign-in (optional) ─────────────────────────────────────────────────
# Leave a provider's pair blank to disable it — the sign-in buttons render from
# whichever providers have credentials here, so an unconfigured provider simply
# does not appear rather than showing a button that fails.
#
# Register the callback URL below with the provider exactly as written.
# Google:  https://console.cloud.google.com/apis/credentials
#          Authorized redirect URI: http://localhost:5173/api/auth/google/callback
# GitHub:  https://github.com/settings/developers
#          Authorization callback URL: http://localhost:5173/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Calendar (optional; uses the same Google OAuth client above)
# 1. Enable the Google Calendar API in the Google Cloud project.
# 2. Add this authorized redirect URI:
#    http://localhost:5173/api/recruiter/calendar/callback
# 3. Generate a dedicated at-rest encryption key with:
#    openssl rand -base64 32
# Keep this key stable. Rotating it requires re-encrypting stored refresh tokens
# or asking recruiters to reconnect their calendars.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Origin the provider redirects back to. Port 5173 in development on purpose:
# Vite proxies /api to the API, so the whole round-trip stays on one origin and
# the session cookies the callback sets are the ones the app then sends.
# Defaults to CORS_ORIGIN when unset.
OAUTH_CALLBACK_BASE_URL=http://localhost:5173
# Frontend origin the callback finally lands the browser on.
APP_BASE_URL=http://localhost:5173

# ─── OpenAI (optional) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_FIT_SCORE_MODEL=gpt-4o-mini
OPENAI_FIT_SCORE_TIMEOUT_MS=20000

# ─── OpenRouter (optional; powers the candidate-facing "Review with AI") ──────
# Get a free key at https://openrouter.ai/keys — the default model below is
# one of OpenRouter's free-tier models, so no billing is required for MVP.
# OpenRouter's free-tier lineup changes over time and old slugs 404; if this
# model stops working, check https://openrouter.ai/api/v1/models for current
# ":free" options and benchmark before switching — see the comment above
# DEFAULT_MODEL in packages/shared/ai/resume-review.ts for what was tried.
OPENROUTER_API_KEY=
OPENROUTER_RESUME_REVIEW_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_RESUME_REVIEW_TIMEOUT_MS=35000

# ─── Storage / S3 (optional) ──────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
