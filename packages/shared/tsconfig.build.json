{
  "extends": "./config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "auth/**/*",
    "ai/**/*",
    "queue/**/*",
    "realtime/**/*",
    "db/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
